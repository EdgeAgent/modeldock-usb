flowchart LR
    USB["ModelDock USB\nPortable runtime"] --> MODE{"Offline / Cloud\nexecution policy"}
    MODE --> LOCAL["Local JSON store\nAtomic state + backups"]
    MODE --> CLOUD["Optional remote services\nExplicit override"]

    ASK["Natural-language\nbusiness ask"] --> CMD["Command Center\nWorkflow planner"]
    CMD --> PLAN["Inspectable workflow\nSteps + timeouts"]
    PLAN --> GATE{"Human approval\nrequired?"}
    GATE -->|Yes| DESK["Human Oversight Desk\nApprove · Deny · Edit · Resubmit"]
    GATE -->|No| RUN["Local LLM agent run"]
    DESK --> RUN

    RUN --> LIVE["Live run monitor\nWebSocket + polling"]
    RUN --> LOG["Audit trail +\nexecution log"]
    RUN --> OUT["Deliverables\nRecovery controls"]

    STOP[["Emergency stop\nFreeze execution"]] -.-> RUN
    STOP -.-> CMD

