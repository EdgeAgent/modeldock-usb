{
  "name": "agent-ops-desk-usb",
  "version": "0.1.0-portable-scaffold",
  "platforms": ["windows-x64", "macos-arm64", "macos-x64", "linux-x64", "linux-arm64"],
  "launchers": {
    "windows": "portable/launch-windows.ps1",
    "macos": "portable/launch-unix.sh",
    "linux": "portable/launch-unix.sh"
  },
  "runtime": {
    "entry": "dist/index.js",
    "port": 4173,
    "systemNodeRequired": true,
    "bundledRuntimePending": true
  },
  "storage": {
    "dataRoot": "portable-data",
    "databaseMode": "portable-configured",
    "secretsMode": "encrypted-first-run-required"
  },
  "connectivity": {
    "dashboard": "local",
    "modelApis": "internet-or-local-model-required",
    "businessIntegrations": "internet-required-unless-local-adapter-bundled"
  },
  "safety": {
    "safeEjectRequired": true,
    "credentialsInLauncher": false,
    "emergencyStopPreserved": true
  }
}
