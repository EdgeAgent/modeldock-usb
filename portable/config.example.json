{
  "port": 4173,
  "persistence": {
    "default": "local-json",
    "stateFile": "portable-data/agent-ops-state.json",
    "mysqlOverride": "set PORTABLE_PERSISTENCE=mysql and provide PORTABLE_DATABASE_URL only when using MySQL/TiDB"
  },
  "model": {
    "provider": "set via PORTABLE_MODEL_PROVIDER",
    "apiBaseUrl": "set via PORTABLE_MODEL_API_URL",
    "apiKey": "never store in this example file"
  },
  "integrations": {
    "mode": "internet-required-unless-local-connectors-are-installed"
  },
  "security": {
    "secretsStorage": "encrypted-portable-data",
    "safeEjectAfterShutdown": true
  }
}
